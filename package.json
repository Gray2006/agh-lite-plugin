{
  "name": "agh-lite-plugin",
  "version": "0.3.3",
  "description": "agh-lite 的 DSH 插件版：一个工具扫本机会话，找出 token 浪费并给出可省上限。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./audit": "./lib/audit.js",
    "./sessions": "./lib/sessions.js",
    "./proxy": "./lib/proxy.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/audit.test.mjs test/proxy.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token",
    "audit",
    "cost"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gray2006/agh-lite-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Gray2006/agh-lite-plugin/issues"
  },
  "homepage": "https://github.com/Gray2006/agh-lite-plugin#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
